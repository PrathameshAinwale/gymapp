<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header to PHP / Laravel (Crucial for Sanctum / Bearer Tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Pass X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Prevent directory listing
    Options -Indexes

    # Block access to sensitive configuration files
    <FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|\.gitignore|\.git)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Block direct web access to backend internals (protects app, bootstrap, config, storage)
    RewriteRule ^backend/(?!public/).* - [F,L]

    # 1. Route /api/* requests to Laravel backend front controller
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]

    # 2. Route /storage/* requests to Laravel public storage
    RewriteCond %{REQUEST_URI} ^/storage(/.*)?$ [NC]
    RewriteRule ^storage/(.*)$ backend/public/storage/$1 [L]

    # 3. Route extract_vendor.php helper if requested
    RewriteRule ^extract_vendor\.php$ backend/extract_vendor.php [L,QSA]

    # 4. Existing files and directories are served directly (JS, CSS, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. React SPA Fallback: Route all other requests to index.html
    RewriteRule ^ index.html [L]
</IfModule>
