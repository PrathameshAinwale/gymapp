<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header to PHP / Laravel (Crucial for Sanctum / Bearer Tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Pass X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Prevent directory listing
    Options -Indexes

    # Block access to sensitive configuration files
    <FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|\.gitignore|\.git)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Block direct web access to backend internals (protects app, bootstrap, config, storage)
    RewriteRule ^backend/(?!public/).* - [F,L]

    # 1. Route /api/* requests to public_html/api/index.php (Bridges to backend outside public_html)
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

    # 2. Route /storage/* requests to backend public storage
    RewriteCond %{REQUEST_URI} ^/storage(/.*)?$ [NC]
    RewriteRule ^storage/(.*)$ api/storage/$1 [L]

    # 3. Route deployment helpers if requested
    RewriteRule ^extract_vendor\.php$ extract_vendor.php [L,QSA]
    RewriteRule ^migrate_backend\.php$ migrate_backend.php [L,QSA]

    # Cache control: cache immutable static assets, never cache HTML/root navigation
    <IfModule mod_headers.c>
        SetEnvIf Request_URI "^/assets/" IS_STATIC_ASSET
        SetEnvIf Request_URI "\.(js|mjs|css|woff2?|ttf|eot|png|jpe?g|gif|svg|ico|webp|map)$" IS_STATIC_ASSET

        Header set Cache-Control "public, max-age=31536000, immutable" env=IS_STATIC_ASSET

        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0" env=!IS_STATIC_ASSET
        Header set Pragma "no-cache" env=!IS_STATIC_ASSET
        Header set Expires "0" env=!IS_STATIC_ASSET
        Header set X-LiteSpeed-Cache-Control "no-cache" env=!IS_STATIC_ASSET
    </IfModule>

    <IfModule LiteSpeed>
        CacheDisable public /
        CacheDisable private /
    </IfModule>

    # 4. Existing files and directories are served directly (JS, CSS, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4b. Never rewrite missing static assets to index.html; return 404 so browsers and Vite handle missing chunks cleanly
    RewriteCond %{REQUEST_URI} ^/assets/ [NC,OR]
    RewriteCond %{REQUEST_URI} \.(js|mjs|css|json|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|map)$ [NC]
    RewriteRule ^ - [R=404,L]

    # 5. React SPA Fallback: Route only navigation / page requests to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/assets/ [NC]
    RewriteCond %{REQUEST_URI} !\.(js|mjs|css|json|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|map)$ [NC]
    RewriteRule ^ index.html [L]
</IfModule>
